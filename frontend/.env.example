NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Read at build time. Leave unset (or anything but 1) for the public demo: controls
# that write shared data (add/delete positions, save to watchlist, status moves) are
# hidden and a read-only note is shown. Set to 1 only for a private, writable setup;
# the backend must allow writes as well.
NEXT_PUBLIC_DEMO_ALLOW_WRITES=
